---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";
import RelatedPosts from "../components/blog/RelatedPosts.astro";
import SmartImage from "../components/SmartImage.astro";
import { formatDate } from "../utils/date";
import { buildPostPath, getPostSlug, getRelatedPosts } from "../utils/blog";

interface Props {
  post: CollectionEntry<"posts">;
  headings?: { depth: number; slug: string; text: string }[];
}

const { post, headings = [] } = Astro.props;
const { title, description, image, date, author, tags, categories, canonical } =
  post.data;
const postSlug = getPostSlug(post);
const canonicalPath = canonical || `/blog/${postSlug}/`;
const shareUrl = Astro.site
  ? new URL(canonicalPath, Astro.site).toString()
  : canonicalPath;
const visibleHeadings = headings
  .filter((heading) => heading.depth === 2 || heading.depth === 3)
  .slice(0, 12);
const encodedTitle = encodeURIComponent(title);
const encodedShareUrl = encodeURIComponent(shareUrl);
const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const sidebarRelatedPosts = getRelatedPosts(
  post,
  allPosts.filter((entry) => getPostSlug(entry) !== postSlug),
  3,
);
---

<Layout
  title={title}
  description={description}
  image={image}
  canonical={canonicalPath}
  ogType="article"
  publishedTime={date?.toISOString()}
  modifiedTime={date?.toISOString()}
  structuredData={{
    type: "article",
    data: {
      headline: title,
      description,
      image,
      datePublished: date?.toISOString(),
      dateModified: date?.toISOString(),
      author,
    },
  }}
>
  <section class="blog-post shell section-padding">
    <div class="container">
      <div class="blog-post__intro">
        <a href="/blog" class="blog-post__back">← Toate articolele</a>

        <div class="blog-post__meta">
          {categories.length > 0 && <span class="meta-category">{categories[0]}</span>}
          {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
          {author && <span>· {author}</span>}
        </div>

        <h1>{title}</h1>
        {description && <p class="blog-post__description">{description}</p>}

        {tags.length > 0 && (
          <div class="blog-post__tags">
            {tags.map((tag) => (
              <span class="blog-post__tag">#{tag}</span>
            ))}
          </div>
        )}
      </div>

      {image && (
        <div class="blog-post__image-wrap">
          <SmartImage src={image} alt={title} class="blog-post__image" fetchpriority="high" width={1200} height={675} widths={[800, 1200]} sizes="(max-width: 1024px) 100vw, 1024px" />
        </div>
      )}

      <div class="blog-post__body">
        <div class="blog-post__content">
          <slot />
        </div>

        <aside class="blog-post__sidebar">
          {visibleHeadings.length > 0 && (
            <nav class="blog-post__panel" aria-label="Cuprins">
              <p class="panel-stamp stamp-ember">Cuprins</p>
              <ul class="blog-post__toc">
                {visibleHeadings.map((heading) => (
                  <li class:list={["blog-post__toc-item", heading.depth === 3 && "is-sub"]}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )}

          {sidebarRelatedPosts.length > 0 && (
            <div class="blog-post__panel">
              <p class="panel-stamp">Citește și</p>
              <div class="blog-post__sidebar-related">
                {sidebarRelatedPosts.map((entry) => (
                  <a href={buildPostPath(getPostSlug(entry))} class="blog-post__sidebar-related-item">
                    {entry.data.image && (
                      <span class="blog-post__sidebar-related-image-wrap" aria-hidden="true">
                        <SmartImage src={entry.data.image} alt="" class="blog-post__sidebar-related-image" width={128} height={96} />
                      </span>
                    )}
                    <span class="blog-post__sidebar-related-title">{entry.data.title}</span>
                  </a>
                ))}
              </div>
            </div>
          )}

          <div class="blog-post__panel">
            <p class="panel-stamp">Distribuie</p>
            <div class="blog-post__share">
              <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodedShareUrl}`} target="_blank" rel="noopener noreferrer">Facebook ↗</a>
              <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedShareUrl}`} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
              <a href={`https://x.com/intent/tweet?url=${encodedShareUrl}&text=${encodedTitle}`} target="_blank" rel="noopener noreferrer">X ↗</a>
              <button type="button" class="blog-post__copy" data-copy-link={shareUrl} aria-live="polite">Copiază linkul</button>
            </div>
          </div>
        </aside>
      </div>

      <RelatedPosts currentPost={post} />
    </div>
  </section>
</Layout>

<script>
  document.addEventListener("click", async (event) => {
    const button = (event.target instanceof Element)
      ? event.target.closest("[data-copy-link]")
      : null;

    if (!(button instanceof HTMLButtonElement)) return;

    const url = button.dataset.copyLink;
    if (!url || !navigator.clipboard) return;

    await navigator.clipboard.writeText(url);
    const originalText = button.textContent;
    button.textContent = "Link copiat ✓";
    window.setTimeout(() => {
      button.textContent = originalText;
    }, 1800);
  });
</script>

<style>
  .blog-post.shell {
    background-color: var(--color-background);
  }

  :global(.dark) .blog-post.shell {
    background-color: var(--color-dark-background);
  }

  /* ——— Intro: centered measure, oversized title ——— */
  .blog-post__intro {
    max-width: 52rem;
    margin: 0 auto 3rem;
    text-align: left;
  }

  .blog-post__back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: 1.5rem;
    color: var(--color-muted);
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
  }

  .blog-post__back:hover {
    color: var(--color-ember-deep);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .blog-post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-bottom: 1.4rem;
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    align-items: center;
  }

  .meta-category {
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-ember-ink);
    background: var(--color-ember);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
  }

  .blog-post h1 {
    margin: 0;
    font-size: clamp(2.4rem, 5.2vw, 3.7rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
    color: var(--color-text);
  }

  :global(.dark) .blog-post h1 {
    color: var(--color-dark-text);
  }

  .blog-post__description {
    margin: 1.25rem 0 0;
    font-size: 1.18rem;
    line-height: 1.65;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  :global(.dark) .blog-post__description {
    color: var(--color-dark-text-light);
  }

  .blog-post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.6rem;
  }

  .blog-post__tag {
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    border: 1.5px solid var(--color-ink);
    background: var(--color-paper);
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 800;
  }

  :global(.dark) .blog-post__tag {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.3);
    color: var(--color-dark-text);
  }

  /* ——— Cover: framed, hard shadow ——— */
  .blog-post__image-wrap {
    max-width: 64rem;
    margin: 0 auto 3.5rem;
    border-radius: 18px;
    overflow: hidden;
    border: 2px solid var(--color-ink);
    box-shadow: 8px 8px 0 var(--color-ink);
  }

  :global(.dark) .blog-post__image-wrap {
    border-color: rgba(255, 255, 255, 0.22);
    box-shadow: 8px 8px 0 rgba(0, 0, 0, 0.6);
  }

  .blog-post__image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* ——— Body: content first, sidebar right ——— */
  .blog-post__body {
    display: grid;
    gap: 3.5rem;
    align-items: start;
    grid-template-columns: minmax(0, 1fr);
    max-width: 74rem;
    margin: 0 auto;
  }

  @media (min-width: 1020px) {
    .blog-post__body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 300px);
    }

    .blog-post__sidebar {
      position: sticky;
      top: 6rem;
    }
  }

  .blog-post__sidebar {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .blog-post__panel {
    border: 2px solid var(--color-ink);
    border-radius: 14px;
    background: var(--color-card);
    padding: 1rem 1.1rem;
  }

  :global(.dark) .blog-post__panel {
    background: var(--color-dark-background-alt);
    border-color: rgba(255, 255, 255, 0.22);
  }

  .panel-stamp {
    display: inline-flex;
    margin: 0 0 0.7rem;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-paper);
    background: var(--color-ink);
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
  }

  :global(.dark) .panel-stamp {
    background: var(--color-paper);
    color: var(--color-ink-deep);
  }

  .stamp-ember {
    color: var(--color-ember-ink);
    background: var(--color-ember);
  }

  :global(.dark) .stamp-ember {
    background: var(--color-ember);
    color: var(--color-ember-ink);
  }

  .blog-post__toc {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .blog-post__toc-item a {
    display: block;
    color: var(--color-muted);
    line-height: 1.4;
    font-size: 0.86rem;
    font-weight: 600;
    text-decoration: none;
    padding: 0.38rem 0.6rem;
    margin: 0 -0.6rem;
    border-radius: 8px;
  }

  :global(.dark) .blog-post__toc-item a {
    color: var(--color-dark-text-light);
  }

  .blog-post__toc-item a:hover {
    color: var(--color-ember-deep);
    background: rgba(201, 58, 0, 0.07);
  }

  :global(.dark) .blog-post__toc-item a:hover {
    color: var(--color-ember-soft);
    background: rgba(255, 255, 255, 0.06);
  }

  .blog-post__toc-item.is-sub a {
    padding-left: 1.2rem;
    font-size: 0.8rem;
  }

  .blog-post__sidebar-related {
    display: grid;
    gap: 0.85rem;
  }

  .blog-post__sidebar-related-item {
    display: flex;
    gap: 0.85rem;
    align-items: center;
    text-decoration: none;
  }

  .blog-post__sidebar-related-image-wrap {
    width: 4rem;
    height: 3rem;
    border-radius: 10px;
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid var(--color-line);
    background: var(--color-paper-2);
  }

  :global(.dark) .blog-post__sidebar-related-image-wrap {
    border-color: rgba(255, 255, 255, 0.16);
  }

  .blog-post__sidebar-related-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .blog-post__sidebar-related-title {
    color: var(--color-text);
    font-size: 0.87rem;
    font-weight: 700;
    line-height: 1.4;
  }

  :global(.dark) .blog-post__sidebar-related-title {
    color: var(--color-dark-text);
  }

  .blog-post__sidebar-related-item:hover .blog-post__sidebar-related-title {
    color: var(--color-ember-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 2px;
  }

  .blog-post__share {
    display: grid;
    gap: 0.5rem;
  }

  .blog-post__share a,
  .blog-post__copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.55rem 0.9rem;
    border: 2px solid var(--color-ink);
    border-radius: 12px;
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 120ms ease, color 120ms ease;
  }

  :global(.dark) .blog-post__share a,
  :global(.dark) .blog-post__copy {
    border-color: rgba(255, 255, 255, 0.3);
    color: var(--color-dark-text);
  }

  .blog-post__share a:hover,
  .blog-post__copy:hover {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }

  :global(.dark) .blog-post__share a:hover,
  :global(.dark) .blog-post__copy:hover {
    background: var(--color-paper);
    border-color: var(--color-paper);
    color: var(--color-ink-deep);
  }

  .blog-post__copy {
    background: var(--color-ember-deep);
    border-color: var(--color-ember-deep);
    color: #fff;
  }

  :global(.dark) .blog-post__copy {
    background: var(--color-ember);
    border-color: var(--color-ember);
    color: var(--color-ember-ink);
  }

  /* ——— Article typography: tighter rhythm, signature h2 ——— */
  .blog-post__content {
    min-width: 0;
    color: var(--color-text);
    line-height: 1.8;
    font-size: 1.125rem;
  }

  :global(.dark) .blog-post__content {
    color: var(--color-dark-text);
  }

  .blog-post__content :global(h2) {
    margin: 2.75rem 0 1.1rem;
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-weight: 640;
    color: var(--color-text);
    text-wrap: balance;
  }

  .blog-post__content :global(h2)::after {
    content: "";
    display: block;
    width: 2rem;
    height: 4px;
    background: var(--color-ember);
    border-radius: 999px;
    margin-top: 0.7rem;
  }

  .blog-post__content :global(h3) {
    margin: 2.1rem 0 0.8rem;
    font-size: 1.35rem;
    line-height: 1.25;
    font-weight: 750;
    color: var(--color-text);
  }

  .blog-post__content :global(h4) {
    margin: 1.75rem 0 0.6rem;
    font-size: 1.1rem;
    font-weight: 750;
    color: var(--color-text);
  }

  :global(.dark) .blog-post__content :global(h2),
  :global(.dark) .blog-post__content :global(h3),
  :global(.dark) .blog-post__content :global(h4) {
    color: var(--color-dark-text);
  }

  .blog-post__content :global(p),
  .blog-post__content :global(ul),
  .blog-post__content :global(ol) {
    margin: 1.15rem 0;
    color: var(--color-text-light);
  }

  :global(.dark) .blog-post__content :global(p),
  :global(.dark) .blog-post__content :global(ul),
  :global(.dark) .blog-post__content :global(ol) {
    color: var(--color-dark-text-light);
  }

  .blog-post__content :global(a:not(.not-prose)) {
    color: var(--color-ember-deep);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgba(201, 58, 0, 0.45);
    text-underline-offset: 3px;
  }

  .blog-post__content :global(a:not(.not-prose):hover) {
    text-decoration-color: var(--color-ember-deep);
  }

  :global(.dark) .blog-post__content :global(a:not(.not-prose)) {
    color: var(--color-ember-soft);
    text-decoration-color: rgba(255, 107, 44, 0.5);
  }

  .blog-post__content :global(ul),
  .blog-post__content :global(ol) {
    padding-left: 1.5rem;
  }

  .blog-post__content :global(li) {
    margin: 0.45rem 0;
  }

  .blog-post__content :global(li::marker) {
    color: var(--color-ember-deep);
    font-weight: 800;
  }

  :global(.dark) .blog-post__content :global(li::marker) {
    color: var(--color-ember-soft);
  }

  /* ——— Tables: real design, not raw browser defaults ——— */
  .blog-post__content :global(table) {
    width: 100%;
    margin: 2rem 0;
    border: 2px solid var(--color-ink);
    border-radius: 14px;
    border-collapse: separate;
    border-spacing: 0;
    display: block;
    overflow-x: auto;
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .blog-post__content :global(thead th) {
    background: var(--color-ink);
    color: var(--color-paper);
    font-weight: 800;
    text-align: left;
    padding: 0.9rem 1.1rem;
  }

  :global(.dark) .blog-post__content :global(thead th) {
    background: #000;
  }

  .blog-post__content :global(tbody th) {
    text-align: left;
    font-weight: 750;
    padding: 0.8rem 1.1rem;
    border-top: 1px solid var(--color-line);
  }

  .blog-post__content :global(td) {
    padding: 0.8rem 1.1rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-text-light);
    vertical-align: top;
  }

  :global(.dark) .blog-post__content :global(tbody th),
  :global(.dark) .blog-post__content :global(td) {
    border-top-color: rgba(255, 255, 255, 0.12);
  }

  :global(.dark) .blog-post__content :global(td) {
    color: var(--color-dark-text-light);
  }

  .blog-post__content :global(tbody tr:hover td),
  .blog-post__content :global(tbody tr:hover th) {
    background: rgba(201, 58, 0, 0.05);
  }

  .blog-post__content :global(caption) {
    caption-side: bottom;
    padding: 0.7rem 0 0;
    font-size: 0.86rem;
    color: var(--color-muted);
    text-align: left;
  }

  .blog-post__content :global(pre) {
    margin: 2rem 0;
    padding: 1.25rem 1.4rem;
    border-radius: 14px;
    border: 2px solid var(--color-ink);
    background: #161a17;
    overflow-x: auto;
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .blog-post__content :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  }

  .blog-post__content :global(p code),
  .blog-post__content :global(li code) {
    background: rgba(201, 58, 0, 0.09);
    border: 1px solid rgba(201, 58, 0, 0.3);
    padding: 0.15em 0.45em;
    border-radius: 6px;
    font-size: 0.85em;
    font-weight: 700;
    color: #a32e00;
  }

  :global(.dark) .blog-post__content :global(p code),
  :global(.dark) .blog-post__content :global(li code) {
    background: rgba(255, 107, 44, 0.12);
    border-color: rgba(255, 107, 44, 0.35);
    color: var(--color-ember-soft);
  }

  /* ——— Quote card instead of side stripe ——— */
  .blog-post__content :global(blockquote) {
    margin: 2.25rem 0;
    padding: 1.6rem 1.75rem 1.5rem;
    border: 2px solid var(--color-ink);
    border-radius: 16px;
    background: var(--color-card);
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.6;
  }

  .blog-post__content :global(blockquote)::before {
    content: "„";
    display: block;
    font-size: 3rem;
    line-height: 0.6;
    color: var(--color-ember);
    margin-bottom: 0.9rem;
  }

  :global(.dark) .blog-post__content :global(blockquote) {
    background: var(--color-dark-background-alt);
    border-color: rgba(255, 255, 255, 0.22);
    color: var(--color-dark-text);
  }

  .blog-post__content :global(blockquote p) {
    margin: 0;
    color: inherit;
  }

  .blog-post__content :global(img) {
    border-radius: 14px;
    border: 2px solid var(--color-ink);
    margin: 2.25rem 0;
    max-width: 100%;
    height: auto;
  }

  :global(.dark) .blog-post__content :global(img) {
    border-color: rgba(255, 255, 255, 0.22);
  }

  /* ——— Mobile: content first, panels stack below ——— */
  @media (max-width: 1019px) {
    .blog-post__body {
      gap: 3rem;
    }

    .blog-post__sidebar {
      border-top: 2px solid var(--color-ink);
      padding-top: 2.5rem;
    }

    :global(.dark) .blog-post__sidebar {
      border-top-color: rgba(255, 255, 255, 0.2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-post__share a,
    .blog-post__copy {
      transition: none;
    }
  }
</style>
