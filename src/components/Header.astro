---
import { navConfig } from "../config/nav";
import { companyConfig } from "../config/company";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  logoText?: string;
  ctaButton?: {
    text: string;
    href: string;
  };
}

const { logoText = companyConfig.logo.text, ctaButton = navConfig.ctaButton } =
  Astro.props;
const currentPath = Astro.url.pathname;
---

<div class="topbar">
  <div class="container topbar-inner">
    <p class="topbar-status"><span class="pulse" aria-hidden="true"></span>Acceptăm proiecte noi · răspuns în 24h</p>
    <a class="topbar-phone" href={`tel:${companyConfig.contact.phone.replace(/\s+/g, "")}`}>{companyConfig.contact.phone}</a>
  </div>
</div>

<header class="site-header sticky top-0 z-40 w-full">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="BitDoze — pagina principală">
      <img src="/bitdoze_logo_better.svg" alt={logoText} class="logo-img" width="180" height="38" />
    </a>

    <nav class="main-nav" aria-label="Navigație principală">
      {
        navConfig.mainNav.map((item) => {
          const isActive =
            currentPath === item.href ||
            (item.href !== "/" && currentPath.startsWith(item.href + "/"));
          return (
            <a
              href={item.href}
              class="nav-link"
              aria-current={isActive ? "page" : undefined}
              data-active={isActive ? "true" : "false"}
            >
              {item.title}
            </a>
          );
        })
      }
    </nav>

    <div class="header-actions">
      <a href="/search" aria-label="Caută în blog" class="icon-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
      <ThemeToggle />
      {
        ctaButton && (
          <a href={ctaButton.href} class="btn btn-primary btn-sm header-cta">
            {ctaButton.text}
          </a>
        )
      }
      <button
        type="button"
        id="mobile-menu-button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Deschide meniul"
        class="icon-btn menu-btn"
      >
        <span class="bars"><span></span><span></span></span>
      </button>
    </div>
  </div>

  {currentPath !== "/contact" && currentPath !== "/multumim" && (
    <a href="/contact" class="sticky-cta">
      <span>Cere ofertă →</span>
      <small>Răspuns în 24h</small>
    </a>
  )}

  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav aria-label="Meniu mobil">
      {
        navConfig.mainNav.map((item) => {
          const isActive =
            currentPath === item.href ||
            (item.href !== "/" && currentPath.startsWith(item.href + "/"));
          return (
            <a
              href={item.href}
              class="mobile-link"
              aria-current={isActive ? "page" : undefined}
              data-active={isActive ? "true" : "false"}
            >
              {item.title}
            </a>
          );
        })
      }
      {ctaButton && <a href={ctaButton.href} class="btn btn-primary mobile-cta">{ctaButton.text} →</a>}
    </nav>
  </div>
</header>

<script>
  const initHeader = () => {
    const menuButton = document.getElementById("mobile-menu-button");
    const mobileMenu = document.getElementById("mobile-menu");
    if (!menuButton || !mobileMenu || menuButton.dataset.bound === "true") return;
    menuButton.dataset.bound = "true";
    menuButton.addEventListener("click", () => {
      const isHidden = mobileMenu.hidden === true;
      mobileMenu.hidden = !isHidden;
      menuButton.setAttribute("aria-expanded", String(isHidden));
      menuButton.setAttribute(
        "aria-label",
        isHidden ? "Închide meniul" : "Deschide meniul"
      );
      menuButton.classList.toggle("is-open", isHidden);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && mobileMenu.hidden === false) {
        mobileMenu.hidden = true;
        menuButton.setAttribute("aria-expanded", "false");
        menuButton.setAttribute("aria-label", "Deschide meniul");
        menuButton.classList.remove("is-open");
        if (menuButton instanceof HTMLElement) menuButton.focus();
      }
    });
    mobileMenu.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => {
        mobileMenu.hidden = true;
        menuButton.setAttribute("aria-expanded", "false");
        menuButton.classList.remove("is-open");
      });
    });
  };
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeader, { once: true });
  } else {
    initHeader();
  }
  document.addEventListener("astro:page-load", initHeader);
</script>

<style>
  /* ——— Ember stencil bar (static, scrolls away) ——— */
  .topbar {
    background: var(--color-ember);
    color: var(--color-ember-ink);
    font-size: 0.84rem;
    border-bottom: 2px solid var(--color-ink-deep);
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.45rem;
    padding-bottom: 0.45rem;
  }
  .topbar-status {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .pulse {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background: var(--color-ink-deep);
    flex-shrink: 0;
    animation: pulse-dot 2s ease-in-out infinite;
  }
  @keyframes pulse-dot {
    50% { opacity: 0.3; }
  }
  .topbar-phone {
    color: var(--color-ember-ink);
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 2px;
    white-space: nowrap;
  }
  .topbar-phone:hover { color: #000; }
  @media (max-width: 640px) {
    .topbar-phone { display: none; }
    .topbar-inner { justify-content: center; }
  }

  .site-header {
    background-color: var(--color-background);
    border-bottom: 3px solid var(--color-ink);
    box-shadow: 0 4px 0 var(--color-ember);
  }
  :global(.dark) .site-header {
    background-color: var(--color-dark-background);
    border-bottom-color: rgba(255, 255, 255, 0.2);
  }
  .header-inner {
    display: flex;
    height: 5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .logo-img {
    height: 2.4rem;
    width: auto;
    display: block;
  }
  .main-nav {
    display: none;
    align-items: center;
    gap: 0.15rem;
  }
  @media (min-width: 900px) {
    .main-nav { display: flex; }
  }
  .nav-link {
    padding: 0.6rem 1.05rem;
    font-size: 1rem;
    font-weight: 750;
    color: var(--color-muted);
    text-decoration: none;
    border-radius: 999px;
    transition: background-color 120ms ease, color 120ms ease;
  }
  .nav-link:hover {
    color: var(--color-text);
    background: rgba(20, 23, 21, 0.06);
  }
  .nav-link[data-active="true"] {
    color: var(--color-ember-ink);
    background: var(--color-ember);
  }
  /* Header CTA already points at /contact — no need for both pills */
  .main-nav .nav-link[href="/contact"] { display: none; }
  :global(.dark) .nav-link { color: var(--color-dark-text-light); }
  :global(.dark) .nav-link:hover {
    color: var(--color-dark-text);
    background: rgba(255, 255, 255, 0.08);
  }
  :global(.dark) .nav-link[data-active="true"] {
    color: var(--color-ember-ink);
    background: var(--color-ember);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    min-width: 44px;
    min-height: 44px;
    border-radius: 12px;
    border: 2px solid transparent;
    color: var(--color-muted);
    background: transparent;
    cursor: pointer;
    transition: border-color 120ms ease, color 120ms ease;
  }
  .icon-btn:hover {
    color: var(--color-text);
    border-color: var(--color-ink);
  }
  :global(.dark) .icon-btn { color: var(--color-dark-text-light); }
  :global(.dark) .icon-btn:hover {
    color: var(--color-dark-text);
    border-color: rgba(255, 255, 255, 0.35);
  }
  .header-cta { display: none; }
  @media (min-width: 900px) {
    .header-cta {
      display: inline-flex;
      box-shadow: 3px 3px 0 var(--color-ink);
      transform: translate(0, 0);
    }
    .header-cta:hover {
      transform: translate(-1px, -1px);
      box-shadow: 4px 4px 0 var(--color-ink);
    }
    .menu-btn { display: none; }
  }
  :global(.dark) .header-cta { box-shadow: 3px 3px 0 #000; }
  :global(.dark) .header-cta:hover { box-shadow: 4px 4px 0 #000; }
  .bars {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 18px;
  }
  .bars span {
    display: block;
    height: 2px;
    background: currentColor;
    transition: transform 160ms ease;
  }
  .menu-btn.is-open .bars span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .menu-btn.is-open .bars span:last-child { transform: translateY(-3.5px) rotate(-45deg); }

  /* ——— Mobile menu: drenched ink panel, oversized links ——— */
  .mobile-menu {
    border-top: 3px solid var(--color-ember);
    background: var(--color-ink-deep);
    background-image: radial-gradient(rgba(255,255,255,0.07) 1px, transparent 1.5px);
    background-size: 22px 22px;
    padding: 1rem 1.25rem 1.5rem;
    animation: menu-in 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes menu-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: none; }
  }
  @media (min-width: 900px) {
    .mobile-menu { display: none; }
  }
  .mobile-menu nav {
    display: flex;
    flex-direction: column;
  }
  .mobile-link {
    padding: 0.9rem 0.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    color: #f2efe6;
    font-family: var(--font-serif);
    font-weight: 640;
    font-size: 1.55rem;
    letter-spacing: -0.015em;
    text-decoration: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .mobile-link::after { content: "→"; color: #8f8b80; font-family: var(--font-sans); }
  .mobile-link[data-active="true"] { color: var(--color-ember-soft); }
  .mobile-link[data-active="true"]::after { color: var(--color-ember-soft); }
  .mobile-cta { margin-top: 1.25rem; width: 100%; }
  .sticky-cta {
    display: none;
    position: fixed;
    left: 0.85rem;
    right: 0.85rem;
    bottom: calc(0.85rem + env(safe-area-inset-bottom));
    z-index: 40;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: var(--color-ember-deep);
    color: #fff;
    border: 2px solid var(--color-ink-deep);
    border-radius: 14px;
    box-shadow: 4px 4px 0 rgba(0,0,0,0.45);
    padding: 0.8rem 1.15rem;
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
  }
  .sticky-cta small { font-size: 0.76rem; font-weight: 600; opacity: 0.9; white-space: nowrap; }
  @media (max-width: 899px) {
    .sticky-cta { display: flex; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse, .mobile-menu, .bars span { animation: none; transition: none; }
  }
</style>
