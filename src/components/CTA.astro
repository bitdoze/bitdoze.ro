---
import { ctaConfig } from "../config/cta";
import { companyConfig } from "../config/company";

interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaLink?: string;
  secondaryText?: string;
  secondaryLink?: string;
  trustedBy?: string;
}

const {
  title = ctaConfig.title,
  subtitle = ctaConfig.description,
  ctaText = ctaConfig.primaryAction.text,
  ctaLink = ctaConfig.primaryAction.href,
  secondaryText = ctaConfig.secondaryAction?.text,
  secondaryLink = ctaConfig.secondaryAction?.href,
  trustedBy,
} = Astro.props;
---

<section class="cta-wrap">
  <div class="container">
    <div class="cta-panel">
      <div class="cta-text">
        <p class="cta-stamp">Proiecte noi · răspuns în 24h</p>
        <h2>{title}</h2>
        <p class="cta-sub">{subtitle}</p>
        {trustedBy && <p class="cta-proof">{trustedBy}</p>}
      </div>
      <div class="cta-actions">
        <a href={ctaLink} class="btn cta-main">{ctaText} →</a>
        {secondaryText && secondaryLink && (
          <a href={secondaryLink} class="cta-alt">{secondaryText}</a>
        )}
        <p class="cta-fine">
          Sau direct la <a href={`tel:${companyConfig.contact.phone.replace(/\s+/g, "")}`}>{companyConfig.contact.phone}</a> · {companyConfig.contact.email}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-wrap {
    background: var(--color-background);
    padding: 5rem 0;
  }
  :global(.dark) .cta-wrap { background: var(--color-dark-background); }
  .cta-panel {
    background: var(--color-ember);
    color: var(--color-ember-ink);
    border: 2px solid var(--color-ink);
    border-radius: 22px;
    padding: 2.75rem;
    display: grid;
    gap: 2.25rem;
    box-shadow: 8px 8px 0 var(--color-ink);
    position: relative;
    overflow: hidden;
  }
  .cta-panel::after {
    content: "24h";
    position: absolute;
    right: -0.5rem;
    bottom: -2.2rem;
    font-family: var(--font-serif);
    font-weight: 640;
    font-size: 9rem;
    line-height: 1;
    color: rgba(0,0,0,0.1);
    pointer-events: none;
  }
  @media (min-width: 900px) {
    .cta-panel {
      grid-template-columns: 1.5fr 1fr;
      padding: 3.5rem 3.75rem;
      align-items: center;
    }
  }
  .cta-stamp {
    display: inline-flex;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--color-ink-deep);
    color: #f2efe6;
    border-radius: 999px;
    padding: 0.45rem 0.95rem;
    margin: 0;
  }
  .cta-panel h2 {
    margin: 1.2rem 0 0.9rem;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--color-ember-ink);
    text-wrap: balance;
  }
  .cta-sub {
    margin: 0;
    color: rgba(22, 16, 10, 0.82);
    font-weight: 500;
    max-width: 36rem;
    line-height: 1.65;
    font-size: 1.05rem;
  }
  .cta-proof {
    margin: 1.3rem 0 0;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-ember-ink);
  }
  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    position: relative;
    z-index: 1;
  }
  @media (min-width: 900px) {
    .cta-actions { border-left: 2px solid rgba(0,0,0,0.2); padding-left: 2.5rem; }
  }
  .cta-main {
    background: var(--color-ink-deep);
    color: #f5f1e6;
    border-color: var(--color-ink-deep);
    font-size: 1.05rem;
    padding: 1rem 1.75rem;
  }
  .cta-main:hover { background: #000; border-color: #000; color: #fff; }
  .cta-alt {
    color: var(--color-ember-ink);
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }
  .cta-fine {
    margin: 0.25rem 0 0;
    font-size: 0.88rem;
    font-weight: 600;
    color: rgba(22, 16, 10, 0.75);
  }
  .cta-fine a { color: var(--color-ember-ink); font-weight: 800; }
</style>
