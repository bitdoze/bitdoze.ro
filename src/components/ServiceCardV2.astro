---
interface Props {
  title: string;
  description: string;
  icon: string;
  link?: string;
  ctaText?: string;
  index?: number;
  badge?: {
    text: string;
    type?: "popular" | "recommended" | "new";
    icon?: string;
  };
  price?: string;
  features?: string[];
  featured?: boolean;
}

const {
  title,
  description,
  link,
  ctaText = "Află mai multe",
  index = 0,
  price,
  features = [],
  featured = false,
} = Astro.props;

const num = String(index + 1).padStart(2, "0");
const variant = `v${index % 3}`;
const Wrapper = link ? "a" : "div";
const ticks = features.slice(0, 3);
---

<Wrapper href={link} class:list={["svc-bold", variant, { "is-featured": featured }]}>
  <span class="svc-visual" aria-hidden="true">
    <span class="svc-giant">{num}</span>
    {price && <span class="svc-price-pill">{price}</span>}
  </span>
  <span class="svc-body">
    <span class="svc-title">{title}</span>
    <span class="svc-desc">{description}</span>
    {ticks.length > 0 && (
      <span class="svc-ticks">
        {ticks.map((f) => (
          <span class="tick"><i aria-hidden="true">✓</i>{f}</span>
        ))}
      </span>
    )}
    <span class="svc-foot">
      <span class="svc-cta">{ctaText} <span aria-hidden="true">→</span></span>
    </span>
  </span>
</Wrapper>

<style>
  .svc-bold {
    display: flex;
    flex-direction: column;
    border: 2px solid var(--color-ink);
    border-radius: 18px;
    overflow: hidden;
    background: var(--color-card);
    text-decoration: none;
    color: inherit;
    height: 100%;
    transition: transform 160ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 160ms ease;
  }
  .svc-bold:hover {
    transform: translate(-2px, -3px);
    box-shadow: 7px 7px 0 var(--color-ink);
  }
  .svc-bold:hover .svc-title { text-decoration: underline; text-decoration-color: var(--color-ember); text-decoration-thickness: 3px; text-underline-offset: 5px; }
  :global(.dark) .svc-bold {
    background: var(--color-dark-background-alt);
    border-color: rgba(255,255,255,0.22);
  }
  :global(.dark) .svc-bold:hover { box-shadow: 7px 7px 0 rgba(0,0,0,0.6); border-color: rgba(255,255,255,0.4); }
  .svc-visual {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    min-height: 148px;
    padding: 1.1rem 1.25rem;
    overflow: hidden;
  }
  .is-featured .svc-visual { min-height: 178px; }
  .v0 .svc-visual { background: var(--color-ink-deep); background-image: radial-gradient(rgba(255,255,255,0.16) 1.2px, transparent 1.6px); background-size: 18px 18px; }
  .v1 .svc-visual { background: var(--color-pine); background-image: repeating-linear-gradient(-45deg, rgba(255,255,255,0.09) 0 2px, transparent 2px 12px); }
  .v2 .svc-visual { background: var(--color-ember); background-image: linear-gradient(rgba(0,0,0,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,0.1) 1px, transparent 1px); background-size: 22px 22px; }
  .svc-giant {
    font-family: var(--font-serif);
    font-weight: 640;
    font-size: 4.6rem;
    line-height: 0.85;
    letter-spacing: -0.03em;
  }
  .v0 .svc-giant { color: var(--color-ember-soft); }
  .v1 .svc-giant { color: #f2efe6; }
  .v2 .svc-giant { color: var(--color-ink-deep); }
  .is-featured .svc-giant { font-size: 5.6rem; }
  .svc-price-pill {
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    border: 2px solid currentColor;
    white-space: nowrap;
  }
  .v0 .svc-price-pill { color: #f2efe6; background: rgba(255,255,255,0.08); }
  .v1 .svc-price-pill { color: #ffe9d6; background: rgba(255,77,0,0.22); border-color: var(--color-ember-soft); }
  .v2 .svc-price-pill { color: var(--color-ink-deep); background: var(--color-paper); border-color: var(--color-ink-deep); }
  .svc-body { display: flex; flex-direction: column; gap: 0.65rem; padding: 1.4rem 1.4rem 1.5rem; flex: 1; }
  .svc-title {
    font-family: var(--font-serif);
    font-weight: 640;
    font-size: 1.55rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .is-featured .svc-title { font-size: 1.9rem; }
  :global(.dark) .svc-title { color: var(--color-dark-text); }
  .svc-desc { color: var(--color-muted); line-height: 1.65; font-size: 0.99rem; }
  :global(.dark) .svc-desc { color: var(--color-dark-text-light); }
  .svc-ticks { display: grid; gap: 0.45rem; margin-top: 0.35rem; }
  .tick { display: flex; gap: 0.55rem; align-items: flex-start; font-size: 0.9rem; font-weight: 600; color: var(--color-ink); }
  :global(.dark) .tick { color: var(--color-dark-text); }
  .tick i {
    font-style: normal;
    flex-shrink: 0;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 999px;
    background: var(--color-ember);
    color: var(--color-ember-ink);
    font-size: 0.8rem;
    font-weight: 900;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.1rem;
  }
  .svc-foot { margin-top: auto; padding-top: 0.9rem; }
  .svc-cta { font-weight: 800; font-size: 0.95rem; color: var(--color-ink); }
  :global(.dark) .svc-cta { color: var(--color-dark-text); }
  @media (prefers-reduced-motion: reduce) {
    .svc-bold, .svc-bold:hover { transform: none; transition: none; }
  }
</style>
