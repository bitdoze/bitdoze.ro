---
import { getCollection } from "astro:content";
import PostCard from "./PostCard.astro";
import { getSortedPosts } from "../../utils/blog";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const latestPosts = getSortedPosts(posts).slice(0, 3);
---

{
  latestPosts.length > 0 && (
    <section class="blog-sec">
      <div class="container">
        <div class="blog-head">
          <div>
            <p class="kicker">Din blog · practic</p>
            <h2>Note practice, nu teorie</h2>
            <p class="lede">
              Scriem despre ce facem zi de zi: viteză, SEO, hosting, mentenanță.
              Fără jargon, cu exemple din proiecte reale.
            </p>
          </div>
          <div class="blog-actions">
            <a href="/blog" class="btn btn-secondary">Toate articolele →</a>
          </div>
        </div>

        <div class="blog-grid">
          {latestPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .blog-sec {
    background: var(--color-background-alt);
    padding: 5rem 0;
    border-top: 2px solid var(--color-ink);
  }
  :global(.dark) .blog-sec { background: var(--color-dark-background); border-top-color: rgba(255,255,255,0.2); }
  .blog-head {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 2.5rem;
  }
  .blog-head h2 {
    margin: 1.1rem 0 0;
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1.02;
    color: var(--color-text);
  }
  :global(.dark) .blog-head h2 { color: var(--color-dark-text); }
  .lede {
    margin: 0.8rem 0 0;
    color: var(--color-muted);
    max-width: 42rem;
    line-height: 1.7;
  }
  :global(.dark) .lede { color: var(--color-dark-text-light); }
  .blog-actions { display: flex; gap: 0.75rem; }
  .blog-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 820px) {
    .blog-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
