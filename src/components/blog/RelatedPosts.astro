---
import { getCollection, type CollectionEntry } from "astro:content";
import { formatDate } from "../../utils/date";
import { buildPostPath, getPostSlug, getRelatedPosts } from "../../utils/blog";
import SmartImage from "../SmartImage.astro";

interface Props {
  currentPost: CollectionEntry<"posts">;
}

const { currentPost } = Astro.props;

const posts = await getCollection("posts", ({ data }) => !data.draft);
const currentPostSlug = getPostSlug(currentPost);
const otherPosts = posts.filter((post) => getPostSlug(post) !== currentPostSlug);
const relatedPosts = getRelatedPosts(currentPost, otherPosts, 3);
---

{
  relatedPosts.length > 0 && (
    <section class="related-posts">
      <h2>Articole similare</h2>
      <div class="related-posts__grid">
        {relatedPosts.map((post) => {
          const href = buildPostPath(getPostSlug(post));
          const category = post.data.categories?.[0];

          return (
            <article class="related-post-card">
              <a href={href} class="related-post-card__link">
                {
                  post.data.image && (
                    <div class="related-post-card__image-wrap">
                      <SmartImage
                        src={post.data.image}
                        alt={post.data.title}
                        class="related-post-card__image"
                        width={800}
                        height={450}
                        widths={[400, 800]}
                        sizes="(max-width: 820px) 100vw, 33vw"
                      />
                    </div>
                  )
                }

                {
                  category && (
                    <span class="related-post-card__badge">{category}</span>
                  )
                }

                <h3>{post.data.title}</h3>

                {
                  post.data.date && (
                    <time datetime={post.data.date.toISOString()}>
                      {formatDate(post.data.date)}
                    </time>
                  )
                }
              </a>
            </article>
          );
        })}
      </div>
    </section>
  )
}

<style>
  .related-posts {
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 2px solid var(--color-ink);
  }

  .related-posts h2 {
    margin: 0 0 1.75rem;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .related-posts__grid {
    display: grid;
    gap: 1.4rem;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
  }

  .related-post-card {
    border: 2px solid var(--color-ink);
    border-radius: 16px;
    background: var(--color-card);
    overflow: hidden;
    transition: transform 160ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 160ms ease;
  }

  .related-post-card:hover {
    transform: translate(-2px, -3px);
    box-shadow: 6px 6px 0 var(--color-ink);
  }

  :global(.dark) .related-post-card {
    background: var(--color-dark-background-alt);
    border-color: rgba(255, 255, 255, 0.22);
  }

  :global(.dark) .related-post-card:hover {
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.6);
  }

  .related-post-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .related-post-card__image-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 2px solid var(--color-ink);
    background: var(--color-paper-2);
  }

  :global(.dark) .related-post-card__image-wrap {
    border-bottom-color: rgba(255, 255, 255, 0.16);
  }

  .related-post-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .related-post-card:hover .related-post-card__image {
    transform: scale(1.03);
  }

  .related-post-card__badge {
    display: inline-block;
    margin: 1.1rem 1.25rem 0;
    color: var(--color-ember-deep);
    font-size: 0.74rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  :global(.dark) .related-post-card__badge {
    color: var(--color-ember-soft);
  }

  .related-post-card h3 {
    margin: 0.5rem 1.25rem 0;
    color: var(--color-text);
    font-family: var(--font-serif);
    font-weight: 640;
    font-size: 1.2rem;
    line-height: 1.3;
  }

  .related-post-card__link:hover h3 {
    text-decoration: underline;
    text-decoration-color: var(--color-ember);
    text-decoration-thickness: 2.5px;
    text-underline-offset: 4px;
  }

  .related-post-card time {
    display: block;
    margin: 0.6rem 1.25rem 1.25rem;
    color: var(--color-muted);
    font-size: 0.85rem;
  }
  :global(.dark) .related-posts {
    border-top-color: rgba(255, 255, 255, 0.2);
  }
  @media (prefers-reduced-motion: reduce) {
    .related-post-card, .related-post-card:hover, .related-post-card__image {
      transform: none !important;
      transition: none;
    }
  }
  :global(.dark) .related-posts h2,
  :global(.dark) .related-post-card h3 {
    color: var(--color-dark-text);
  }
  :global(.dark) .related-post-card time {
    color: var(--color-dark-text-light);
  }
  :global(.dark) .related-post-card__image-wrap {
    border-color: rgba(255, 255, 255, 0.1);
  }
</style>
