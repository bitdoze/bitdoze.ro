---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../../utils/date";
import { buildPostPath, getPostSlug } from "../../utils/blog";
import SmartImage from "../SmartImage.astro";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const href = buildPostPath(getPostSlug(post));
---

<article class="post">
  <a href={href} class="post-link">
    {post.data.image && (
      <span class="post-img">
        <SmartImage src={post.data.image} alt={post.data.title} width={800} height={450} widths={[400, 800]} sizes="(max-width: 820px) 100vw, 33vw" />
      </span>
    )}
    <span class="post-body">
      <span class="post-meta">
        {post.data.categories?.[0] && <span class="post-cat">{post.data.categories[0]}</span>}
        {post.data.date && <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>}
      </span>
      <span class="post-title">{post.data.title}</span>
      {post.data.description && <span class="post-desc">{post.data.description}</span>}
      <span class="post-more">Citește articolul →</span>
    </span>
  </a>
</article>

<style>
  .post { height: 100%; display: flex; }
  .post-link {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: var(--color-card);
    border: 2px solid var(--color-ink);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 160ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 160ms ease;
  }
  :global(.dark) .post-link {
    background: var(--color-dark-background-alt);
    border-color: rgba(255,255,255,0.22);
  }
  .post-link:hover { transform: translate(-2px, -3px); box-shadow: 6px 6px 0 var(--color-ink); }
  .post-link:hover .post-title { text-decoration: underline; text-decoration-color: var(--color-ember); text-decoration-thickness: 2.5px; text-underline-offset: 4px; }
  .post-img {
    display: block;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: var(--color-paper-2);
    border-bottom: 1px solid var(--color-line);
  }
  :global(.dark) .post-img { border-bottom-color: rgba(255,255,255,0.1); }
  .post-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .post-body { padding: 1.35rem 1.35rem 1.5rem; display: flex; flex-direction: column; gap: 0.6rem; flex: 1; }
  .post-meta {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--color-faint);
  }
  .post-cat { color: var(--color-ember-deep); font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; }
  .post-title {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    line-height: 1.3;
    color: var(--color-text);
  }
  :global(.dark) .post-title { color: var(--color-dark-text); }
  .post-desc {
    font-size: 0.94rem;
    line-height: 1.65;
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  :global(.dark) .post-desc { color: var(--color-dark-text-light); }
  .post-more {
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--color-ink);
  }
  :global(.dark) .post-more { color: var(--color-dark-text); }
</style>
