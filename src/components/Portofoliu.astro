---
import { getCollection } from "astro:content";
import { getCollectionSlug } from "../utils/content";
import SmartImage from "./SmartImage.astro";

interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaLink?: string;
  limit?: number;
}

const {
  title = "Lucrări recente",
  subtitle = "O selecție de site-uri construite și întreținute de noi. Fiecare cu problemă, soluție și rezultat — nu doar capturi de ecran.",
  ctaText = "Vezi tot portofoliul",
  ctaLink = "/portofoliu",
  limit = 3,
} = Astro.props;

const portofoliu = await getCollection("portofoliu", ({ data }) => !data.draft);
const latestProjects = portofoliu
  .sort((a, b) => b.data.data.getTime() - a.data.data.getTime())
  .slice(0, limit);
---

<section class="work">
  <div class="container">
    <div class="work-head">
      <div>
        <p class="kicker kicker-dark">Portofoliu · live</p>
        <h2>{title}</h2>
        <p class="lede">{subtitle}</p>
      </div>
      <a href={ctaLink} class="btn btn-ghost-invert">{ctaText} →</a>
    </div>

    <div class="work-grid">
      {latestProjects.map((project) => (
        <a href={`/portofoliu/${getCollectionSlug(project)}`} class="work-card">
          <span class="work-img">
            <SmartImage src={project.data.imagine} alt={project.data.title} width={800} height={500} widths={[400, 800]} sizes="(max-width: 820px) 100vw, 33vw" />
          </span>
          <span class="work-meta">
            <span class="work-client">{project.data.title}</span>
            <span class="work-stack">{project.data.stack.slice(0, 3).join(" · ")}</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .work {
    background: var(--color-ink-deep);
    color: #f2efe6;
    border-top: 2px solid var(--color-ink-deep);
    padding: 5rem 0;
    background-image: radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1.5px);
    background-size: 24px 24px;
  }
  .kicker-dark {
    background: var(--color-ember);
    color: var(--color-ember-ink);
  }
  .kicker-dark::before { background: var(--color-ink-deep); }
  .work-head {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 2.5rem;
  }
  .work-head h2 {
    margin: 1.1rem 0 0;
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1.02;
    color: #f5f1e6;
    text-wrap: balance;
  }
  .lede {
    margin: 0.9rem 0 0;
    color: #c2bcae;
    max-width: 42rem;
    line-height: 1.7;
    font-size: 1.05rem;
  }
  .btn-ghost-invert { border-width: 2px; font-weight: 700; }
  .work-grid {
    display: grid;
    gap: 1.4rem;
  }
  @media (min-width: 820px) {
    .work-grid { grid-template-columns: repeat(3, 1fr); }
    .work-card:first-child { grid-column: span 2; }
    .work-card:first-child .work-img { aspect-ratio: 16/8; }
  }
  .work-card {
    text-decoration: none;
    color: inherit;
    display: grid;
    gap: 0.9rem;
    border: 2px solid rgba(255,255,255,0.2);
    border-radius: 16px;
    padding: 0.8rem;
    background: rgba(255,255,255,0.04);
    transition: transform 160ms cubic-bezier(0.22, 1, 0.36, 1), border-color 160ms ease;
  }
  .work-card:hover { transform: translate(-2px, -3px); border-color: var(--color-ember); }
  .work-img {
    display: block;
    aspect-ratio: 16/10;
    overflow: hidden;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.16);
    background: #fff;
  }
  .work-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
    transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .work-card:hover .work-img img { transform: scale(1.03); }
  .work-meta { display: grid; gap: 0.25rem; padding: 0 0.35rem 0.4rem; }
  .work-client {
    font-family: var(--font-serif);
    font-weight: 640;
    font-size: 1.3rem;
    color: #f5f1e6;
  }
  .work-card:hover .work-client { color: var(--color-ember-soft); }
  .work-stack {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: #8f8b80;
  }
  @media (prefers-reduced-motion: reduce) {
    .work-card, .work-img img { transform: none !important; transition: none; }
  }
</style>
