---
interface Props {
  title: string;
  descriere: string;
  imagine: string;
  url: string;
  stack: string[];
  servicii: string[];
  slug?: string;
}

const { title, descriere, imagine, url, stack, servicii, slug } = Astro.props;
const href = slug ? `/portofoliu/${slug}` : url;
---

<article class="pcard">
  <a href={href} class="pcard-img" aria-label={title} tabindex="-1">
    <img src={imagine} alt={`Captură site ${title}`} loading="lazy" decoding="async" />
  </a>
  <div class="pcard-body">
    <h3 class="pcard-title">
      <a href={href}>{title}</a>
    </h3>
    <p class="pcard-desc">{descriere}</p>
    <p class="pcard-meta">{stack.slice(0, 4).join(" · ")}</p>
    <p class="pcard-meta dim">{servicii.slice(0, 3).join(" · ")}</p>
    <div class="pcard-actions">
      {slug && <a href={`/portofoliu/${slug}`} class="text-link">Studiu de caz →</a>}
      <a href={url} target="_blank" rel="noopener noreferrer" class="text-link dim-link">Site live ↗</a>
    </div>
  </div>
</article>

<style>
  .pcard {
    border: 2px solid var(--color-ink);
    border-radius: 16px;
    background: var(--color-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 160ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 160ms ease;
  }
  .pcard:hover {
    transform: translate(-2px, -3px);
    box-shadow: 6px 6px 0 var(--color-ink);
  }
  :global(.dark) .pcard {
    background: var(--color-dark-background-alt);
    border-color: rgba(255,255,255,0.22);
  }
  :global(.dark) .pcard:hover { box-shadow: 6px 6px 0 rgba(0,0,0,0.6); }
  .pcard-img {
    display: block;
    aspect-ratio: 16/10;
    overflow: hidden;
    background: var(--color-paper-2);
    border-bottom: 2px solid var(--color-ink);
  }
  .pcard-img img { transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1); }
  .pcard:hover .pcard-img img { transform: scale(1.03); }
  :global(.dark) .pcard-img { border-bottom-color: rgba(255,255,255,0.1); }
  .pcard-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pcard-body { padding: 1.25rem 1.25rem 1.4rem; display: flex; flex-direction: column; gap: 0.6rem; flex: 1; }
  .pcard-title { margin: 0; font-size: 1.25rem; }
  .pcard-title a { color: var(--color-text); text-decoration: none; }
  :global(.dark) .pcard-title a { color: var(--color-dark-text); }
  .pcard-title a:hover { text-decoration: underline; text-decoration-color: var(--color-ember); text-decoration-thickness: 2.5px; text-underline-offset: 4px; }
  .pcard-desc {
    margin: 0;
    font-size: 0.93rem;
    line-height: 1.65;
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  :global(.dark) .pcard-desc { color: var(--color-dark-text-light); }
  .pcard-meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--color-muted);
  }
  :global(.dark) .pcard-meta { color: var(--color-dark-text-light); }
  .pcard-meta.dim { color: var(--color-faint); }
  .pcard-actions {
    display: flex;
    gap: 1.25rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-line);
  }
  :global(.dark) .pcard-actions { border-top-color: rgba(255,255,255,0.1); }
  .text-link { font-weight: 800; font-size: 0.9rem; color: var(--color-ember-deep); text-decoration: none; }
  :global(.dark) .text-link { color: var(--color-ember-soft); }
  .text-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .dim-link { color: var(--color-muted); font-weight: 500; }
  @media (prefers-reduced-motion: reduce) {
    .pcard, .pcard:hover, .pcard-img img { transform: none !important; transition: none; }
  }
</style>
