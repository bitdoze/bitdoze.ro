---
interface Props {
  title: string;
  subtitle?: string;
  align?: "left" | "center" | "right";
  contentMaxWidth?: "sm" | "md" | "lg" | "xl" | "2xl" | "3xl" | "4xl" | "5xl" | "6xl" | "full";
  kicker?: string;
  /* legacy props kept for compat — intentionally ignored (no blobs/grids) */
  withBlobs?: boolean;
  withGrid?: boolean;
  backgroundStyle?: "primary" | "secondary" | "accent" | "neutral";
  decoration?: "pattern1" | "pattern2" | "none";
  icon?: string;
}

const {
  title,
  subtitle,
  align = "left",
  contentMaxWidth = "3xl",
  kicker,
} = Astro.props;

const alignStyle = align === "center" ? "margin-inline:auto;text-align:left" : align === "right" ? "margin-left:auto" : "";

const maxWidths: Record<string, string> = {
  sm: "36rem", md: "44rem", lg: "54rem", xl: "62rem",
  "2xl": "70rem", "3xl": "54rem", "4xl": "70rem",
  "5xl": "76rem", "6xl": "80rem", full: "100%",
};
---

<section class="page-head">
  <div class="container">
    <div class="page-head__inner" style={`${alignStyle};max-width:${maxWidths[contentMaxWidth]}`}>
      <p class="kicker">{kicker ?? Astro.url.pathname.replaceAll("/", " ").trim().replace(/^ /, "")}</p>
      <h1>{title}</h1>
      {subtitle && <p class="lede">{subtitle}</p>}
      <slot />
    </div>
  </div>
</section>

<style>
  .page-head {
    background: var(--color-background);
    border-bottom: 2px solid var(--color-ink);
    padding: 4rem 0 3.25rem;
  }
  :global(.dark) .page-head {
    background: var(--color-dark-background);
    border-bottom-color: rgba(255,255,255,0.2);
  }
  .page-head h1 {
    margin: 1.2rem 0 0;
    font-size: clamp(2.4rem, 5.4vw, 3.9rem);
    line-height: 1.0;
    letter-spacing: -0.03em;
    color: var(--color-text);
    text-wrap: balance;
  }
  :global(.dark) .page-head h1 { color: var(--color-dark-text); }
  .lede {
    margin: 1.1rem 0 0;
    font-size: 1.12rem;
    line-height: 1.7;
    color: var(--color-muted);
    max-width: 44rem;
  }
  :global(.dark) .lede { color: var(--color-dark-text-light); }
</style>
