---
interface Badge {
  icon: string;
  value: string;
  label: string;
  color?: string;
}

interface Props {
  badges?: Badge[];
  variant?: "default" | "compact" | "inline";
  className?: string;
}

const defaultBadges: Badge[] = [
  { icon: "mdi:shield-check", value: "10+", label: "ani de experiență" },
  { icon: "mdi:briefcase-check", value: "50+", label: "proiecte livrate" },
  { icon: "mdi:headset", value: "24h", label: "timp de răspuns" },
  { icon: "mdi:star", value: "din 2014", label: "atelier în România" },
];

const { badges = defaultBadges, className = "" } = Astro.props;
---

<div class={`proof ${className}`}>
  {badges.map((badge) => (
    <div class="proof-item">
      <span class="proof-value">{badge.value}</span>
      <span class="proof-label">{badge.label}</span>
    </div>
  ))}
</div>

<style>
  .proof {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border: 2px solid var(--color-ink);
    border-radius: 16px;
    background: var(--color-card);
    overflow: hidden;
    box-shadow: 6px 6px 0 var(--color-ink);
  }
  @media (min-width: 760px) {
    .proof { grid-template-columns: repeat(4, 1fr); }
  }
  :global(.dark) .proof {
    background: var(--color-dark-background-alt);
    border-color: rgba(255,255,255,0.2);
    box-shadow: 6px 6px 0 rgba(0,0,0,0.6);
  }
  .proof-item {
    padding: 1.25rem 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .proof-item + .proof-item { border-left: 2px solid var(--color-ink); }
  :global(.dark) .proof-item + .proof-item { border-left-color: rgba(255,255,255,0.16); }
  @media (max-width: 759px) {
    .proof-item:nth-child(3) { border-left: 0; }
    .proof-item:nth-child(n+3) { border-top: 2px solid var(--color-ink); }
  }
  .proof-value {
    font-family: var(--font-serif);
    font-weight: 640;
    font-size: 2rem;
    line-height: 1;
    color: var(--color-ink);
  }
  .proof-value::after {
    content: "";
    display: block;
    width: 1.75rem;
    height: 4px;
    background: var(--color-ember);
    border-radius: 999px;
    margin-top: 0.5rem;
  }
  :global(.dark) .proof-value { color: var(--color-dark-text); }
  .proof-label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-muted);
    margin-top: 0.35rem;
  }
  :global(.dark) .proof-label { color: var(--color-dark-text-light); }
</style>
