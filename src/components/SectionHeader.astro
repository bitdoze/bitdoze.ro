---
interface Props {
  title: string;
  subtitle?: string;
  alignment?: "left" | "center" | "right";
  textSize?: "sm" | "md" | "lg";
  decorative?: boolean;
  badge?: {
    text: string;
    type?: "primary" | "secondary" | "accent" | "success";
    icon?: string;
  };
  className?: string;
  kicker?: string;
}

const {
  title,
  subtitle,
  alignment = "left",
  badge,
  className = "",
  kicker,
} = Astro.props;
---

<div class={`sec-head align-${alignment} ${className}`}>
  <p class="kicker">{kicker ?? badge?.text ?? "BitDoze"}</p>
  <h2>{title}</h2>
  {subtitle && <p class="sec-sub">{subtitle}</p>}
</div>

<style>
  .sec-head { margin-bottom: 2.5rem; max-width: 52rem; }
  .sec-head.align-center { margin-inline: auto; }
  .sec-head h2 {
    margin: 0.9rem 0 0;
    font-size: clamp(1.7rem, 3.2vw, 2.4rem);
    color: var(--color-text);
  }
  :global(.dark) .sec-head h2 { color: var(--color-dark-text); }
  .sec-sub {
    margin: 0.9rem 0 0;
    color: var(--color-muted);
    line-height: 1.7;
    font-size: 1.05rem;
  }
  :global(.dark) .sec-sub { color: var(--color-dark-text-light); }
</style>
