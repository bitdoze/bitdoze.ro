---
interface Testimonial {
  content: string;
  author: string;
  role: string;
  company: string;
  avatar?: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  testimonials?: Testimonial[];
}

const {
  title = "Ce spun clienții",
  subtitle = "Relații lungi, nu proiecte de o lună. O parte din clienți sunt cu noi de ani de zile.",
  testimonials = [],
} = Astro.props;
---

{testimonials.length > 0 && (
<section class="testi">
  <div class="container">
    <div class="testi-head">
      <div>
        <p class="kicker">Recomandări</p>
        <h2>{title}</h2>
      </div>
      <p class="lede">{subtitle}</p>
    </div>
    <div class="testi-grid">
      {testimonials.map((t) => (
        <figure class="quote">
          <span class="qmark" aria-hidden="true">„</span>
          <blockquote>{t.content}</blockquote>
          <figcaption>
            <strong>{t.author}</strong>
            <span>{t.role}, {t.company}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
)}

<style>
  .testi {
    background: var(--color-background);
    border-top: 2px solid var(--color-ink);
    padding: 5rem 0;
  }
  :global(.dark) .testi { background: var(--color-dark-background); border-top-color: rgba(255,255,255,0.2); }
  .testi-head {
    display: grid;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 960px) {
    .testi-head { grid-template-columns: 1.2fr 0.8fr; gap: 3rem; align-items: end; }
  }
  .testi h2 {
    margin: 1.1rem 0 0;
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1.02;
    color: var(--color-text);
  }
  :global(.dark) .testi h2 { color: var(--color-dark-text); }
  .lede { margin: 0; color: var(--color-muted); line-height: 1.7; font-size: 1.05rem; }
  :global(.dark) .lede { color: var(--color-dark-text-light); }
  .testi-grid { display: grid; gap: 1.4rem; }
  @media (min-width: 860px) { .testi-grid { grid-template-columns: repeat(3, 1fr); } }
  .quote {
    margin: 0;
    border: 2px solid rgba(255,255,255,0.22);
    border-radius: 18px;
    background: var(--color-ink-deep);
    color: #f2efe6;
    padding: 1.75rem 1.6rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
    overflow: hidden;
  }
  .quote:nth-child(2) { transform: rotate(0.6deg); }
  .quote:nth-child(3) { transform: rotate(-0.6deg); }
  .qmark {
    font-family: var(--font-serif);
    font-size: 4rem;
    line-height: 0.6;
    color: var(--color-ember);
    display: block;
    margin-top: 0.6rem;
  }
  .quote blockquote {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.12rem;
    line-height: 1.6;
    color: #f2efe6;
  }
  .quote figcaption {
    display: grid;
    gap: 0.15rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid rgba(255,255,255,0.16);
  }
  .quote strong { font-size: 0.94rem; color: #fff; }
  .quote span { font-size: 0.84rem; color: #8f8b80; }
  @media (prefers-reduced-motion: reduce) {
    .quote { transform: none; }
  }
</style>
