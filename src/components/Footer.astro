---
import { navConfig } from "../config/nav";
import { companyConfig } from "../config/company";

interface Props {
  companyName?: string;
  companyTagline?: string;
}

const {
  companyName = companyConfig.name,
  companyTagline = companyConfig.tagline,
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <p class="status-pill"><span class="pulse" aria-hidden="true"></span>Acceptăm proiecte noi · răspuns în 24h</p>
      <button type="button" class="to-top" data-to-top>↑ Sus</button>
    </div>

    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <img src="/bitdoze_logo_better.svg" alt="BitDoze" width="160" height="34" />
        </a>
        <p class="footer-tagline">{companyTagline}</p>
        <div class="footer-contact-pills">
          <a href={`mailto:${companyConfig.contact.email}`}>{companyConfig.contact.email}</a>
          <a href={`tel:${companyConfig.contact.phone.replace(/\s+/g, "")}`}>{companyConfig.contact.phone}</a>
        </div>
        <p class="footer-firm">{companyConfig.legalName} · CUI {companyConfig.cui}<br />{companyConfig.contact.address.street}, {companyConfig.contact.address.city}, jud. {companyConfig.contact.address.state} {companyConfig.contact.address.zip}</p>
        <div class="footer-social">
          {
            companyConfig.socialMedia.map((social) => (
              <a href={social.url} class="social-link" aria-label={social.platform} target="_blank" rel="noopener noreferrer">
                {social.platform} ↗
              </a>
            ))
          }
        </div>
      </div>

      <nav class="footer-col" aria-label="Resurse">
        <p class="footer-heading">Resurse</p>
        <ul>
          {navConfig.footerNav.resources.map((item) => (
            <li><a href={item.href}>{item.title}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="footer-col" aria-label="Companie">
        <p class="footer-heading">Companie</p>
        <ul>
          {navConfig.footerNav.company.map((item) => (
            <li><a href={item.href}>{item.title}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="footer-col" aria-label="Legal">
        <p class="footer-heading">Legal</p>
        <ul>
          {navConfig.footerNav.legal.map((item) => (
            <li><a href={item.href}>{item.title}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <p class="wordmark" aria-hidden="true">BitDoze</p>

    <div class="footer-bottom">
      <p>© {currentYear} {companyConfig.legalName} · CUI: {companyConfig.cui} · Făcut cu grijă în România</p>
      <div class="footer-anpc">
        <a href="https://anpc.ro/ce-este-sal/" target="_blank" rel="noopener noreferrer" aria-label="ANPC — SAL pentru consumatori">
          <img src="/anpc-sal.webp" alt="ANPC — SAL pentru consumatori" width="160" height="40" loading="lazy" />
        </a>
        <a href="https://ec.europa.eu/consumers/odr/main/index.cfm?event=main.home2.show&lng=RO" target="_blank" rel="noopener noreferrer" aria-label="ANPC — Soluționarea Online a Litigiilor (SOL)">
          <img src="/anpc-sol.png" alt="ANPC — Soluționarea Online a Litigiilor (SOL)" width="160" height="40" loading="lazy" />
        </a>
      </div>
      <div class="footer-legal-links">
        <button type="button" class="link-btn" data-open-cookie-settings>Setări cookie-uri</button>
        <a href="/contact">Contact</a>
      </div>
    </div>
  </div>
</footer>

<script>
  document.addEventListener("click", (event) => {
    const button = (event.target instanceof Element)
      ? event.target.closest("[data-to-top]")
      : null;
    if (!(button instanceof HTMLButtonElement)) return;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
  });
</script>

<style>
  .site-footer {
    background: var(--color-ink-deep);
    background-image: radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1.5px);
    background-size: 24px 24px;
    color: #c2bcae;
    margin-top: 0;
    border-top: 4px solid var(--color-ember);
  }
  .footer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2.5rem;
  }
  .status-pill {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.84rem;
    font-weight: 800;
    color: var(--color-ember-ink);
    background: var(--color-ember);
    border-radius: 999px;
    padding: 0.55rem 1.1rem;
  }
  .status-pill .pulse { background: var(--color-ink-deep); }
  .pulse {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--color-ember);
    flex-shrink: 0;
    animation: pulse-dot 2s ease-in-out infinite;
  }
  @keyframes pulse-dot {
    50% { opacity: 0.3; }
  }
  .to-top {
    background: var(--color-ember);
    border: 0;
    border-radius: 999px;
    color: var(--color-ember-ink);
    font: inherit;
    font-size: 0.86rem;
    font-weight: 800;
    padding: 0.6rem 1.25rem;
    min-height: 44px;
    cursor: pointer;
    transition: transform 120ms ease;
  }
  .to-top:hover { transform: translateY(-2px); }
  .footer-grid {
    display: grid;
    gap: 2.5rem;
    padding-top: 2.5rem;
    padding-bottom: 3rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .footer-grid { grid-template-columns: 1.6fr 1fr 1fr 1fr; }
  }
  .footer-logo img {
    height: 2.1rem;
    width: auto;
    filter: brightness(0) invert(1);
  }
  .footer-tagline {
    margin: 1rem 0 1.25rem;
    max-width: 26rem;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: #f2efe6;
  }
  .footer-contact-pills {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }
  .footer-contact-pills a {
    font-size: 0.9rem;
    font-weight: 700;
    color: #f2efe6;
    text-decoration: none;
    border: 1.5px solid rgba(255,255,255,0.25);
    border-radius: 12px;
    padding: 0.6rem 1rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    overflow-wrap: anywhere;
  }
  .footer-contact-pills a::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-ember);
    flex-shrink: 0;
  }
  .footer-firm { margin: 1rem 0 0; font-size: 0.82rem; line-height: 1.7; color: #8f8b80; }
  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }
  .social-link {
    font-size: 0.84rem;
    font-weight: 700;
    color: #f2efe6;
    text-decoration: none;
    border-bottom: 2px solid rgba(255,255,255,0.25);
    padding-bottom: 2px;
  }
  .social-link:hover { border-bottom-color: var(--color-ember); color: var(--color-ember-soft); }
  .footer-heading {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #f2efe6;
    margin: 0 0 1.1rem;
  }
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  .footer-col a {
    color: #c2bcae;
    text-decoration: none;
    font-size: 0.93rem;
    font-weight: 550;
  }
  .footer-col a:hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
  .wordmark {
    margin: 1rem 0 -0.5rem;
    font-family: var(--font-serif);
    font-weight: 640;
    font-size: clamp(4.5rem, 15vw, 13rem);
    line-height: 0.85;
    letter-spacing: -0.035em;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(242, 239, 230, 0.35);
    white-space: nowrap;
    overflow: hidden;
    user-select: none;
  }
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.12);
    padding-top: 1.5rem;
    padding-bottom: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    font-size: 0.82rem;
    color: #8f8b80;
  }
  .footer-anpc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }
  .footer-anpc a {
    display: inline-block;
    background: #fff;
    border-radius: 8px;
    padding: 6px;
    line-height: 0;
    transition: opacity 120ms ease;
  }
  .footer-anpc a:hover { opacity: 0.8; }
  .footer-anpc img {
    height: 2.5rem;
    width: auto;
    display: block;
  }
  .footer-legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }
  .footer-legal-links a { color: #c2bcae; text-decoration: none; }
  .footer-legal-links a:hover { color: #fff; }
  .link-btn {
    background: none;
    border: 0;
    padding: 0;
    color: #c2bcae;
    font: inherit;
    cursor: pointer;
  }
  .link-btn:hover { color: #fff; }
  @media (prefers-reduced-motion: reduce) {
    .pulse { animation: none; }
  }
</style>
