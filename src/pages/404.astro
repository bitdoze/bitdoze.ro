---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Pagina nu a fost găsită" description="Pagina căutată nu există sau a fost mutată." noindex={true}>
  <section class="lost">
    <div class="container lost-inner">
      <p class="kicker">Eroare 404</p>
      <p class="lost-giant" aria-hidden="true">404</p>
      <h1>Pagina asta nu există.</h1>
      <p class="lede">
        Poate ai greșit o literă, poate am mutat noi pagina. Oricum, nu pleca cu mâna goală:
      </p>
      <div class="lost-actions">
        <a href="/" class="btn btn-primary btn-lg">Înapoi acasă →</a>
        <a href="/servicii" class="btn btn-secondary btn-lg">Vezi serviciile</a>
      </div>
      <p class="lost-fine">Cauți ceva anume? <a href="/contact">Scrie-ne</a> și te ajutăm direct.</p>
    </div>
  </section>
</Layout>

<style>
  .lost {
    background: var(--color-ink-deep);
    color: #f2efe6;
    padding: 5rem 0 6rem;
    background-image: radial-gradient(rgba(255,255,255,0.07) 1px, transparent 1.5px);
    background-size: 22px 22px;
  }
  .lost-inner { max-width: 46rem; }
  .kicker { background: var(--color-ember); color: var(--color-ember-ink); }
  .kicker::before { background: var(--color-ink-deep); }
  .lost-giant {
    margin: 1.5rem 0 0;
    font-family: var(--font-serif);
    font-weight: 640;
    font-size: clamp(5rem, 16vw, 10rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 2px var(--color-ember);
  }
  .lost h1 {
    margin: 1.25rem 0 0;
    font-size: clamp(2rem, 5vw, 3.2rem);
    color: #f5f1e6;
  }
  .lede { margin: 1rem 0 0; font-size: 1.1rem; line-height: 1.7; color: #c2bcae; }
  .lost-actions { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2rem; }
  .lost-fine { margin: 1.75rem 0 0; color: #8f8b80; }
  .lost-fine a { color: var(--color-ember-soft); font-weight: 700; }
  @media (max-width: 640px) {
    .lost-actions .btn { width: 100%; }
  }
</style>
