---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/blog/PostCard.astro";
import { getSortedPosts } from "../utils/blog";
import { siteConfig } from "../config/site";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts(posts);
---

<Layout
  title={`Blog | ${siteConfig.name}`}
  description="Articole practice în limba română despre web design, SEO, hosting și procese digitale."
  canonical="/blog"
>
  <section class="blog-index">
    <div class="container">
      <div class="blog-index__hero">
        <p class="kicker">Blog · în română, fără jargon</p>
        <h1>Ce am învățat din proiecte reale</h1>
        <p class="blog-index__description">
          Ghiduri scurte despre site-uri, SEO și infrastructură web —
          scrise de oamenii care fac efectiv munca.
        </p>
        <p class="blog-index__meta">
          <span>{sortedPosts.length} articole</span>
          <span aria-hidden="true">·</span>
          <a href="/search">Caută în blog →</a>
        </p>
      </div>

      <div class="blog-index__grid">
        {sortedPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .blog-index {
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-line);
    padding: 3.5rem 0 4.5rem;
  }
  :global(.dark) .blog-index {
    background-color: var(--color-dark-background);
    border-bottom-color: rgba(255,255,255,0.1);
  }
  .blog-index__hero { max-width: 48rem; margin-bottom: 2.75rem; }
  .blog-index h1 {
    margin: 1rem 0 0;
    font-size: clamp(2.2rem, 4.8vw, 3.4rem);
    color: var(--color-text);
  }
  :global(.dark) .blog-index h1 { color: var(--color-dark-text); }
  .blog-index__description {
    margin: 1rem 0 0;
    color: var(--color-muted);
    line-height: 1.75;
    font-size: 1.08rem;
  }
  :global(.dark) .blog-index__description { color: var(--color-dark-text-light); }
  .blog-index__meta {
    display: flex;
    gap: 0.75rem;
    margin: 1.25rem 0 0;
    font-size: 0.9rem;
    color: var(--color-muted);
  }
  .blog-index__meta a { color: var(--color-moss); font-weight: 600; }
  :global(.dark) .blog-index__meta a { color: var(--color-ember-soft); }
  .blog-index__grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 720px) {
    .blog-index__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1080px) {
    .blog-index__grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
