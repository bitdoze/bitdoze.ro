---
import Layout from "../layouts/Layout.astro";
import LatestArticles from "../components/blog/LatestArticles.astro";
import Welcome from "../components/Welcome.astro";
import ServiceCardV2 from "../components/ServiceCardV2.astro";
import Portofoliu from "../components/Portofoliu.astro";
import HomeFaq from "../components/HomeFaq.astro";
import CTA from "../components/CTA.astro";
import TrustBadges from "../components/TrustBadges.astro";

import { homePageConfig } from "../config/pages";
import { getCollection } from "astro:content";
import { getCollectionSlug } from "../utils/content";

const welcomeSection = homePageConfig.sections.find(
  (section) => section.type === "welcome"
);
const portfolioSection = homePageConfig.sections.find(
  (section) => section.type === "portfolio"
);
const ctaSection = homePageConfig.sections.find(
  (section) => section.type === "cta"
);

const servicii = await getCollection("servicii", ({ data }) => !data.draft);
const featuredServices = servicii
  .sort((a, b) => a.data.ordine - b.data.ordine)
  .slice(0, 5);
---

<Layout
  title={homePageConfig.title}
  description={homePageConfig.description}
  image={homePageConfig.ogImage}
>
  {welcomeSection && (
    <Welcome
      title={welcomeSection.title}
      subtitle={welcomeSection.subtitle}
      ctas={welcomeSection.ctas}
    />
  )}

  <div class="proof-strip">
    <div class="container">
      <TrustBadges variant="compact" />
    </div>
  </div>

  <section class="svc-sec">
    <div class="container">
      <div class="svc-head">
        <div>
          <p class="kicker">Servicii · prețuri fixe</p>
          <h2>Puține lucruri,<br />făcute să vândă.</h2>
        </div>
        <div class="svc-head-side">
          <p>
            Nu vindem „pachete de creștere exponențială". Facem site-uri,
            magazine online, SEO tehnic și mentenanță — cu preț și termen
            scrise înainte să începem.
          </p>
          <a href="/servicii" class="btn btn-secondary">Toate serviciile →</a>
        </div>
      </div>
      <div class="svc-cards">
        {featuredServices.map((service, index) => (
          <ServiceCardV2
            title={service.data.title}
            description={service.data.descriere}
            icon={service.data.icon}
            link={`/servicii/${getCollectionSlug(service)}`}
            price={service.data.pret}
            index={index}
            ctaText="Detalii"
            features={service.data.caracteristici ?? []}
            featured={index === 0}
          />
        ))}
      </div>
    </div>
  </section>

  <LatestArticles />

  {portfolioSection && (
    <Portofoliu
      title={portfolioSection.title}
      subtitle={portfolioSection.subtitle}
      ctaText={portfolioSection.cta?.text}
      ctaLink={portfolioSection.cta?.link}
      limit={portfolioSection.limit ?? 5}
    />
  )}

  <HomeFaq />

  {ctaSection && (
    <CTA
      title={ctaSection.title}
      subtitle={ctaSection.subtitle}
      ctaText={ctaSection.ctaPrimary.text}
      ctaLink={ctaSection.ctaPrimary.link}
      secondaryText={ctaSection.ctaSecondary?.text}
      secondaryLink={ctaSection.ctaSecondary?.link}
      trustedBy={ctaSection.trustedBy}
    />
  )}
</Layout>

<style>
  .proof-strip {
    background: var(--color-ink-deep);
    background-image: radial-gradient(rgba(255,255,255,0.07) 1px, transparent 1.5px);
    background-size: 22px 22px;
    padding: 0 0 4.5rem;
    margin-top: -1px;
    position: relative;
    z-index: 2;
  }
  .proof-strip :global(.proof) { box-shadow: 6px 6px 0 rgba(0,0,0,0.55); }
  :global(.dark) .proof-strip { background: var(--color-dark-background); }
  .proof-strip .container { max-width: 76rem; }

  .svc-sec {
    background: var(--color-background);
    border-top: 2px solid var(--color-ink);
    padding: 5rem 0;
  }
  :global(.dark) .svc-sec {
    background: var(--color-dark-background);
    border-top-color: rgba(255,255,255,0.2);
  }
  .svc-head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 960px) {
    .svc-head { grid-template-columns: 1.2fr 0.8fr; gap: 3rem; align-items: end; }
  }
  .svc-head h2 {
    margin: 1.1rem 0 0;
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--color-text);
    text-wrap: balance;
  }
  :global(.dark) .svc-head h2 { color: var(--color-dark-text); }
  .svc-head-side p {
    color: var(--color-muted);
    line-height: 1.7;
    margin: 0 0 1.4rem;
    font-size: 1.05rem;
  }
  :global(.dark) .svc-head-side p { color: var(--color-dark-text-light); }
  .svc-cards {
    display: grid;
    gap: 1.4rem;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
  }
  @media (min-width: 1080px) {
    .svc-cards :global(.svc-bold.is-featured) { grid-column: span 2; }
  }
</style>
