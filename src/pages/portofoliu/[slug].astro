---
import { getCollection, getEntry, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import CTA from "../../components/CTA.astro";

export async function getStaticPaths() {
  const portofoliuEntries = await getCollection("portofoliu");
  return portofoliuEntries.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx?$/, "") },
    props: { entryId: entry.id },
  }));
}

interface Props {
  entryId: CollectionEntry<"portofoliu">["id"];
}

const { entryId } = Astro.props;
const entry = await getEntry("portofoliu", entryId);

if (!entry) {
  throw new Error(`Portfolio entry not found: ${entryId}`);
}

const { Content } = await render(entry);

const dateFormatter = new Intl.DateTimeFormat("ro-RO", {
  year: "numeric",
  month: "long",
});
const formattedDate = dateFormatter.format(entry.data.data);
---

<Layout
  title={`${entry.data.title} — Studiu de caz`}
  description={entry.data.descriere}
  ogType="article"
>
  <section class="case-hero">
    <div class="container case-grid">
      <div>
        <p class="kicker kicker-dark">Studiu de caz · {formattedDate}</p>
        <h1>{entry.data.title}</h1>
        <p class="lede">{entry.data.descriere}</p>
        <dl class="case-facts">
          <div><dt>Stack</dt><dd>{entry.data.stack.join(" · ")}</dd></div>
          <div><dt>Servicii</dt><dd>{entry.data.servicii.join(" · ")}</dd></div>
        </dl>
        <div class="hero-actions">
          <a href={entry.data.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">Vezi site-ul live ↗</a>
          <a href="/portofoliu" class="back-link">← Toate proiectele</a>
        </div>
      </div>
      <figure class="case-shot">
        <figcaption class="browser-bar"><span></span><span></span><span></span><em>{entry.data.title} — site live</em></figcaption>
        <img src={entry.data.imagine} alt={`Captură site ${entry.data.title}`} fetchpriority="high" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="case-body">
    <div class="container case-narrow">
      <article class="prose prose-lg">
        <Content />
      </article>
      <hr class="rule" />
      <div class="case-next">
        <a href="/portofoliu" class="back-link-dark">← Înapoi la portofoliu</a>
        <a href="/contact" class="btn btn-secondary">Vrei ceva similar? →</a>
      </div>
    </div>
  </section>

  <CTA
    title="Vrei un site ca acesta?"
    subtitle="Trimite-ne 3–4 fraze despre proiect și primești preț fix și termen în 24h lucrătoare."
    ctaText="Cere ofertă"
    ctaLink="/contact"
    secondaryText="Vezi serviciile"
    secondaryLink="/servicii"
  />
</Layout>

<style>
  .case-hero {
    background: var(--color-ink-deep);
    color: #f2efe6;
    padding: 4rem 0 3.5rem;
    background-image:
      radial-gradient(560px 380px at 88% -8%, rgba(255, 77, 0, 0.2), transparent 65%),
      radial-gradient(rgba(255,255,255,0.07) 1px, transparent 1.5px);
    background-size: auto, 22px 22px;
  }
  .kicker-dark { background: var(--color-ember); color: var(--color-ember-ink); }
  .kicker-dark::before { background: var(--color-ink-deep); }
  .case-grid { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 960px) {
    .case-grid { grid-template-columns: 1fr 1.1fr; gap: 3.5rem; align-items: center; }
  }
  .case-hero h1 {
    margin: 1.2rem 0 0;
    font-size: clamp(2.4rem, 5.4vw, 3.9rem);
    line-height: 1.0;
    letter-spacing: -0.03em;
    color: #f5f1e6;
    text-wrap: balance;
  }
  .lede { margin: 1.1rem 0 0; font-size: 1.12rem; line-height: 1.7; color: #c2bcae; max-width: 40rem; }
  .case-facts {
    display: grid;
    gap: 1rem;
    margin: 1.75rem 0 0;
    padding-top: 1.4rem;
    border-top: 1px solid rgba(255,255,255,0.16);
  }
  .case-facts dt {
    font-family: var(--font-sans);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #8f8b80;
  }
  .case-facts dd { margin: 0.3rem 0 0; font-size: 0.95rem; font-weight: 600; color: #f2efe6; overflow-wrap: break-word; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; margin-top: 2rem; }
  .back-link { font-size: 0.92rem; font-weight: 700; color: #c2bcae; text-decoration: none; }
  .back-link:hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
  .case-shot {
    margin: 0;
    border: 2px solid rgba(255,255,255,0.22);
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    box-shadow: 10px 10px 0 rgba(0,0,0,0.45);
  }
  .browser-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #161c19;
    padding: 0.6rem 0.9rem;
  }
  .browser-bar span { width: 10px; height: 10px; border-radius: 999px; background: rgba(255,255,255,0.25); }
  .browser-bar span:first-child { background: var(--color-ember); }
  .browser-bar em {
    font-style: normal;
    font-size: 0.75rem;
    color: #8f8b80;
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .case-shot img { display: block; width: 100%; height: auto; }
  .case-body { background: var(--color-background); padding: 3.5rem 0 4.5rem; }
  :global(.dark) .case-body { background: var(--color-dark-background); }
  .case-narrow { max-width: 46rem; }
  .case-next {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    margin-top: 2.5rem;
  }
  .back-link-dark { font-size: 0.92rem; font-weight: 700; color: var(--color-muted); text-decoration: none; }
  .back-link-dark:hover { color: var(--color-text); text-decoration: underline; text-underline-offset: 4px; }
</style>
