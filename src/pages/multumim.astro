---
import Layout from "../layouts/Layout.astro";
import { companyConfig } from "../config/company";

const pageTitle = "Mulțumim pentru mesaj!";
const pageDescription =
  "Mesajul a fost trimis cu succes. Îți răspundem în maximum 24 de ore lucrătoare.";
---

<Layout title={pageTitle} description={pageDescription} noindex={true}>
  <section class="thanks">
    <div class="container thanks-inner">
      <p class="kicker">Mesaj trimis ✓</p>
      <h1>Mulțumim! Am primit mesajul.</h1>
      <p class="lede">
        Îți răspundem în maximum <strong>24 de ore lucrătoare</strong> — de obicei mult mai repede.
        Între timp, iată ce se întâmplă:
      </p>

      <ol class="steps">
        <li><strong>Citim cererea.</strong> Omul care face site-ul, nu un robot.</li>
        <li><strong>Răspundem în 24h.</strong> Cu întrebări bune sau direct cu propunerea.</li>
        <li><strong>Primești preț + termen.</strong> Negru pe alb, pe mail.</li>
      </ol>

      <div class="thanks-cards">
        <a href={`mailto:${companyConfig.contact.email}`} class="tcard">
          <span class="tlabel">Email</span>
          <span class="tvalue">{companyConfig.contact.email}</span>
        </a>
        <a href={`tel:${companyConfig.contact.phone.replace(/\s+/g, "")}`} class="tcard">
          <span class="tlabel">Telefon urgent</span>
          <span class="tvalue">{companyConfig.contact.phone}</span>
        </a>
      </div>

      <div class="thanks-actions">
        <a href="/" class="btn btn-primary btn-lg">Înapoi acasă →</a>
        <a href="/portofoliu" class="btn btn-secondary btn-lg">Vezi portofoliul</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .thanks {
    background: var(--color-ink-deep);
    color: #f2efe6;
    padding: 5rem 0 6rem;
    background-image: radial-gradient(rgba(255,255,255,0.07) 1px, transparent 1.5px);
    background-size: 22px 22px;
  }
  .thanks-inner { max-width: 46rem; }
  .kicker { background: var(--color-ember); color: var(--color-ember-ink); }
  .kicker::before { background: var(--color-ink-deep); }
  .thanks h1 {
    margin: 1.25rem 0 0;
    font-size: clamp(2.2rem, 5.4vw, 3.6rem);
    line-height: 1.0;
    letter-spacing: -0.03em;
    color: #f5f1e6;
    text-wrap: balance;
  }
  .lede { margin: 1.1rem 0 0; font-size: 1.1rem; line-height: 1.7; color: #c2bcae; }
  .lede strong { color: #f2efe6; }
  .steps {
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
    counter-reset: steps;
  }
  .steps li {
    position: relative;
    padding: 1rem 1.2rem 1rem 3.5rem;
    border: 2px solid rgba(255,255,255,0.22);
    border-radius: 14px;
    background: rgba(255,255,255,0.04);
    color: #c2bcae;
    line-height: 1.6;
    counter-increment: steps;
  }
  .steps li::before {
    content: counter(steps);
    position: absolute;
    left: 1rem;
    top: 1rem;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 999px;
    background: var(--color-ember);
    color: var(--color-ember-ink);
    font-weight: 900;
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .steps li strong { color: #f2efe6; }
  .thanks-cards { display: grid; gap: 1rem; margin-top: 1.5rem; }
  @media (min-width: 640px) { .thanks-cards { grid-template-columns: 1fr 1fr; } }
  .tcard {
    display: grid;
    gap: 0.25rem;
    border: 2px solid rgba(255,255,255,0.22);
    border-radius: 14px;
    padding: 1.1rem 1.25rem;
    text-decoration: none;
    transition: border-color 120ms ease;
  }
  .tcard:hover { border-color: var(--color-ember); }
  .tlabel {
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #8f8b80;
  }
  .tvalue { font-weight: 700; color: #f2efe6; overflow-wrap: break-word; }
  .thanks-actions { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2.25rem; }
  @media (max-width: 640px) {
    .thanks-actions .btn { width: 100%; }
  }
  @media (max-width: 859px) {
    /* No sticky CTA on this page -> no bottom room needed */
    :global(body) { padding-bottom: 0; }
  }
</style>
