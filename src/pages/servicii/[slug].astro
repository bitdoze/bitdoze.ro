---
import { getCollection, getEntry, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import CTA from "../../components/CTA.astro";
import { getCollectionSlug } from "../../utils/content";

export async function getStaticPaths() {
  const serviciiEntries = await getCollection("servicii");
  return serviciiEntries.map((entry) => ({
    params: { slug: getCollectionSlug(entry) },
    props: { entryId: entry.id },
  }));
}

interface Props {
  entryId: CollectionEntry<"servicii">["id"];
}

const { entryId } = Astro.props;
const entry = await getEntry("servicii", entryId);

if (!entry) {
  throw new Error(`Service entry not found: ${entryId}`);
}

const { Content } = await render(entry);
const serviceSlug = getCollectionSlug(entry);

const allServices = await getCollection("servicii", ({ data }) => !data.draft);
const relatedServices = allServices
  .filter((service) => getCollectionSlug(service) !== serviceSlug)
  .sort((left, right) => left.data.ordine - right.data.ordine)
  .slice(0, 3);

const {
  title,
  descriere,
  pret,
  durata,
  seo,
} = entry.data;
const caracteristiciList = entry.data.caracteristici ?? [];
const beneficiiList = entry.data.beneficii ?? [];
const intrebariList = entry.data.intrebari_frecvente ?? [];
---

<Layout title={seo.title} description={seo.description} ogType="article" structuredData={{ type: "service", data: { name: title, description: descriere } }}>
  <section class="svc-hero">
    <div class="container svc-hero-grid">
      <div>
        <p class="kicker kicker-dark">Servicii · {title}</p>
        <h1>{title}</h1>
        <p class="lede">{descriere}</p>
        <div class="fact-row">
          {pret && <span class="fact-pill fact-price">{pret}</span>}
          {durata && <span class="fact-pill">{durata}</span>}
        </div>
        <div class="hero-actions">
          <a href="/contact" class="btn btn-primary btn-lg">Cere ofertă →</a>
          <a href="/servicii" class="back-link">← Toate serviciile</a>
        </div>
      </div>
      <aside class="toc" aria-label="Pe această pagină">
        <p class="toc-label">Pe această pagină</p>
        <ul>
          <li><a href="#continut">Descriere</a></li>
          {caracteristiciList.length > 0 && <li><a href="#caracteristici">Ce primești</a></li>}
          {beneficiiList.length > 0 && <li><a href="#beneficii">De ce contează</a></li>}
          {intrebariList.length > 0 && <li><a href="#intrebari">Întrebări frecvente</a></li>}
        </ul>
      </aside>
    </div>
  </section>

  <section class="svc-body">
    <div class="container svc-body-grid">
      <div class="svc-main">
        <article id="continut" class="prose prose-lg">
          <Content />
        </article>

        {caracteristiciList.length > 0 && (
          <div id="caracteristici" class="block">
            <p class="kicker">Ce primești</p>
            <h2>Concret, în preț intră:</h2>
            <ul class="check-list">
              {caracteristiciList.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        )}

        {beneficiiList.length > 0 && (
          <div id="beneficii" class="block">
            <p class="kicker">De ce contează</p>
            <h2>Ce câștigi din asta</h2>
            <ul class="plain-list">
              {beneficiiList.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        )}

        {intrebariList.length > 0 && (
          <div id="intrebari" class="block">
            <p class="kicker">Întrebări frecvente</p>
            <h2>Ce ne întreabă clienții</h2>
            <div class="faq">
              {intrebariList.map((item) => (
                <details>
                  <summary>{item.intrebare}</summary>
                  <p>{item.raspuns}</p>
                </details>
              ))}
            </div>
          </div>
        )}
      </div>

      <aside class="svc-side">
        <div class="side-card side-cta">
          <p class="side-stamp">Estimare gratuită</p>
          <p class="side-text">Spune-ne 3–4 fraze despre proiect și primești preț fix și termen în 24h lucrătoare.</p>
          <a href="/contact" class="btn btn-primary" style="width:100%">Cere ofertă →</a>
          <a href="/portofoliu" class="side-link">Vezi proiecte similare →</a>
        </div>
        <div class="side-card">
          <p class="side-label">Alte servicii</p>
          <ul class="side-list">
            {relatedServices.map((s) => (
              <li><a href={`/servicii/${getCollectionSlug(s)}`}>{s.data.title}</a></li>
            ))}
            <li><a href="/servicii">Toate serviciile →</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <CTA
    title={`Vrei ${title.toLowerCase()} făcut bine din prima?`}
    subtitle="Un mail scurt e suficient. Primești preț fix, termen și ce e inclus — fără call de vânzări."
    ctaText="Cere ofertă"
    ctaLink="/contact"
    secondaryText="Vezi toate serviciile"
    secondaryLink="/servicii"
  />
</Layout>

<style>
  .svc-hero {
    background: var(--color-ink-deep);
    color: #f2efe6;
    padding: 4rem 0 3.5rem;
    background-image:
      radial-gradient(560px 380px at 88% -8%, rgba(255, 77, 0, 0.2), transparent 65%),
      radial-gradient(rgba(255,255,255,0.07) 1px, transparent 1.5px);
    background-size: auto, 22px 22px;
  }
  .kicker-dark { background: var(--color-ember); color: var(--color-ember-ink); }
  .kicker-dark::before { background: var(--color-ink-deep); }
  .svc-hero-grid { display: grid; gap: 2.5rem; }
  @media (min-width: 960px) {
    .svc-hero-grid { grid-template-columns: 1.7fr 1fr; gap: 4rem; align-items: start; }
    .toc { position: sticky; top: 6rem; }
  }
  .svc-hero h1 {
    margin: 1.2rem 0 0;
    font-size: clamp(2.4rem, 5.4vw, 3.9rem);
    line-height: 1.0;
    letter-spacing: -0.03em;
    color: #f5f1e6;
    text-wrap: balance;
  }
  .lede { margin: 1.1rem 0 0; font-size: 1.12rem; line-height: 1.7; color: #c2bcae; max-width: 42rem; }
  .fact-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .fact-pill {
    font-size: 0.9rem;
    font-weight: 800;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    border: 2px solid rgba(255,255,255,0.35);
    color: #f2efe6;
  }
  .fact-price {
    background: var(--color-ember);
    border-color: var(--color-ember);
    color: var(--color-ember-ink);
  }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; margin-top: 2rem; }
  .back-link { font-size: 0.92rem; font-weight: 700; color: #c2bcae; text-decoration: none; }
  .back-link:hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
  .toc {
    border: 2px solid rgba(255,255,255,0.22);
    border-radius: 16px;
    background: rgba(255,255,255,0.05);
    padding: 1.35rem 1.45rem;
  }
  .toc-label {
    display: inline-flex;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ember-ink);
    background: var(--color-ember);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    margin: 0 0 1rem;
  }
  .toc ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.65rem; }
  .toc a { color: #f2efe6; font-size: 0.94rem; font-weight: 600; text-decoration: none; }
  :global(.dark) .toc a { color: var(--color-dark-text); }
  .toc a:hover { color: var(--color-ember-soft); text-decoration: underline; text-underline-offset: 4px; }

  .svc-body { background: var(--color-background); padding: 3.5rem 0 4.5rem; }
  :global(.dark) .svc-body { background: var(--color-dark-background); }
  .svc-body-grid { display: grid; gap: 3rem; }
  @media (min-width: 960px) {
    .svc-body-grid { grid-template-columns: 1.7fr 1fr; gap: 3.5rem; align-items: start; }
    .svc-side { position: sticky; top: 6rem; display: grid; gap: 1.4rem; }
  }
  @media (max-width: 959px) { .svc-side { display: grid; gap: 1.4rem; } }
  .block { margin-top: 3.25rem; padding-top: 2.5rem; border-top: 2px solid var(--color-ink); }
  :global(.dark) .block { border-top-color: rgba(255,255,255,0.2); }
  .block h2 { margin: 1.1rem 0 1.4rem; font-size: clamp(1.6rem, 3vw, 2.2rem); letter-spacing: -0.025em; color: var(--color-text); }
  :global(.dark) .block h2 { color: var(--color-dark-text); }
  .check-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .check-list li {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    border: 2px solid var(--color-ink);
    border-radius: 12px;
    background: var(--color-card);
    padding: 0.9rem 1.1rem;
    color: var(--color-text);
    font-weight: 550;
    line-height: 1.6;
  }
  :global(.dark) .check-list li { background: var(--color-dark-background-alt); border-color: rgba(255,255,255,0.2); color: var(--color-dark-text); }
  .check-list li::before {
    content: "✓";
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    background: var(--color-ember);
    color: var(--color-ember-ink);
    font-size: 0.85rem;
    font-weight: 900;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.15rem;
  }
  .plain-list { margin: 0; padding-left: 1.25rem; display: grid; gap: 0.7rem; color: var(--color-muted); line-height: 1.7; }
  :global(.dark) .plain-list { color: var(--color-dark-text-light); }
  .faq { display: grid; gap: 0.8rem; }
  .faq details {
    border: 2px solid var(--color-ink);
    border-radius: 12px;
    background: var(--color-card);
    padding: 1rem 1.2rem;
  }
  :global(.dark) .faq details { background: var(--color-dark-background-alt); border-color: rgba(255,255,255,0.2); }
  .faq summary { cursor: pointer; font-weight: 700; color: var(--color-text); min-height: 44px; display: flex; align-items: center; }
  :global(.dark) .faq summary { color: var(--color-dark-text); }
  .faq details p { margin: 0.6rem 0 0.2rem; color: var(--color-muted); line-height: 1.7; }
  :global(.dark) .faq details p { color: var(--color-dark-text-light); }

  .side-card {
    border: 2px solid var(--color-ink);
    border-radius: 16px;
    background: var(--color-card);
    padding: 1.5rem;
  }
  :global(.dark) .side-card { background: var(--color-dark-background-alt); border-color: rgba(255,255,255,0.22); }
  .side-cta {
    background: var(--color-ink-deep);
    color: #f2efe6;
    box-shadow: 6px 6px 0 rgba(20, 23, 21, 0.9);
  }
  :global(.dark) .side-cta { box-shadow: 6px 6px 0 rgba(0,0,0,0.6); }
  .side-stamp {
    display: inline-flex;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ember-ink);
    background: var(--color-ember);
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
    margin: 0 0 1rem;
  }
  .side-label {
    display: inline-flex;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-paper);
    background: var(--color-ink);
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
    margin: 0 0 1rem;
  }
  :global(.dark) .side-label { background: var(--color-paper); color: var(--color-ink-deep); }
  .side-text { font-size: 0.94rem; color: #c2bcae; line-height: 1.65; margin: 0 0 1.2rem; }
  .side-cta .side-link { color: var(--color-ember-soft); }
  .side-link { display: inline-block; margin-top: 0.9rem; font-size: 0.9rem; font-weight: 700; color: var(--color-ember-deep); text-decoration: none; }
  .side-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .side-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .side-list a { color: var(--color-text); font-size: 0.95rem; font-weight: 600; text-decoration: none; }
  :global(.dark) .side-list a { color: var(--color-dark-text); }
  .side-list a:hover { color: var(--color-ember-deep); text-decoration: underline; text-underline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
</style>
